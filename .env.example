# ===========================================
# PetVida Care - Variáveis de Ambiente
# ===========================================
# Copie este arquivo para .env e preencha os valores

# Firebase Configuration (obrigatório)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=petvida-care.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=petvida-care
VITE_FIREBASE_STORAGE_BUCKET=petvida-care.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Site URL
VITE_SITE_URL=https://petvida.net.br

# Stripe Configuration (para checkout online)
#Obtenha em: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
VITE_STRIPE_PREMIUM_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx

# ===========================================
# Variáveis Server-side (NÃO expostas ao cliente)
# ===========================================
# Configure estas no Firebase Console > Functions > Configuration

# Stripe Secret Key (Backend only)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Stripe Webhook Secret
# Obtenha rodando: stripe listen --forward-to localhost:5001/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Site URL (Server-side)
SITE_URL=https://petvida.net.br
