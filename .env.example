# ===========================================
# PetVida Care - Variáveis de Ambiente
# ===========================================
# Copie este arquivo para .env e preencha os valores.
# Nenhum valor abaixo é um segredo real — são apenas placeholders.

# Firebase Configuration (obrigatório)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Chave pública VAPID para notificações push (Firebase Console > Cloud Messaging)
VITE_FIREBASE_VAPID_KEY=your_vapid_public_key

# Site URL
VITE_SITE_URL=https://petvida.net.br

# ===========================================
# Variáveis Server-side (Cloud Functions Secrets)
# ===========================================
# Configure via `firebase functions:secrets:set NOME` — nunca em texto puro.

# Stripe Secret Key (Backend only)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Stripe Webhook Secret
# Obtenha rodando: stripe listen --forward-to <sua-url-da-function>
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
