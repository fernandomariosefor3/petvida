rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /plans/{planId} {
      allow read: if true;
      allow write: if false; // managed by scripts/seed-plans.mjs via the Admin SDK
    }

    match /paymentEvents/{eventId} {
      allow read, write: if false; // audit log written by the Stripe webhook (Admin SDK only)
    }

    match /stripeEvents/{eventId} {
      allow read, write: if false; // webhook idempotency ledger (Admin SDK only)
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Self-registration only ever creates a free-tier profile; any other
      // plan must be granted by the admin (custom claim) or the Stripe
      // webhook (Admin SDK, which bypasses rules entirely).
      allow create: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.plan == 'free'
        && request.resource.data.planExpiresAt == ''
      );

      // Users may update their own profile fields, but never the
      // plan/quota/billing fields — those are server-managed (Stripe
      // webhook, onUserPlanChangedSyncLimits, admin custom claim actions).
      // Fails closed: any attempt to touch a protected key is denied
      // outright rather than only checking the values being set.
      allow update: if isAdmin() || (
        isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'plan', 'planExpiresAt', 'petLimit', 'reminderLimitPerPet', 'petCount',
          'paymentFailedAt', 'stripeCustomerId', 'stripeSubscriptionId',
          'subscriptionStatus', 'cancelAtPeriodEnd'
        ])
      );

      match /fcmTokens/{token} {
        allow read, write: if isOwner(userId);
      }
    }

    match /pets/{petId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());

      // Creation and deletion always go through the createPet/deletePet
      // Callable Functions (functions/src/pets.ts), which validate the plan
      // limit and update petCount atomically in the same transaction —
      // something Firestore rules cannot do safely on their own. The Admin
      // SDK those functions use bypasses these rules entirely, so closing
      // both operations here is what actually enforces "no direct client
      // writes", not a false sense of security from a limit check in rules.
      allow create: if false;
      allow delete: if false;

      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId
        && request.auth.uid == request.resource.data.userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reminderCount']);
    }

    match /reminders/{reminderId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());

      // Same reasoning as pets/{petId} above — createReminder/deleteReminder
      // Callable Functions own quota enforcement and counter updates.
      allow create: if false;
      allow delete: if false;

      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.petId == resource.data.petId;
    }

    match /healthRecords/{recordId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.petId == resource.data.petId;
    }
  }
}
