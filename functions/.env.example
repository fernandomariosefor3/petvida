# ===========================================
# Firebase Functions - Variáveis de Ambiente
# ===========================================
# Copie para functions/.env.<project-id> (ex: functions/.env.petvid-82a98)
# ou configure via `firebase functions:config` / painel do Functions.
# Nenhum valor abaixo é real — são apenas placeholders.

# Price IDs do Stripe Dashboard (Products) — não são segredos, mas ainda
# assim configuráveis por ambiente, nunca fixados na lógica do código.
STRIPE_PRO_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx

# ===========================================
# Secrets (configure via Secret Manager, NÃO neste arquivo)
# ===========================================
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
#
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
